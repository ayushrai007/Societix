# Local development settings, read by docker compose and by the backend.
#
#   cp .env.example .env
#
# .env is git-ignored. These are throwaway local values only: never put real credentials here.
# The defaults already work; change a value only if it clashes with something on your machine
# (for example, another Postgres already using port 5432).

# PostgreSQL 18 + pgvector (compose service: postgres)
DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/societix
# Runtime role the application connects as. It is not a superuser, so tenant RLS applies to it.
SPRING_DATASOURCE_USERNAME=societix_app
SPRING_DATASOURCE_PASSWORD=societix_app
# Owner role: owns the schema and runs the Flyway migrations.
SPRING_FLYWAY_USER=societix
SPRING_FLYWAY_PASSWORD=societix

# Firebase Auth Emulator is local only. Deployed environments must use their real project ID
# and leave FIREBASE_AUTH_EMULATOR_HOST empty.
FIREBASE_PROJECT_ID=demo-societix-local
FIREBASE_JWK_SET_URI=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
FIREBASE_ADMIN_ENABLED=false
# Set this only when the local Firebase Auth Emulator is running. Keep empty outside local development.
FIREBASE_AUTH_EMULATOR_HOST=
# Generate a local key with: openssl rand -base64 32. Never commit the generated key.
SOCIETIX_PHONE_ENCRYPTION_KEY=
# Set only for a one-time, restricted initial PLATFORM_ADMIN bootstrap; unset immediately after.
SOCIETIX_PLATFORM_ADMIN_BOOTSTRAP_FIREBASE_UID=


# Redis 8.2 (compose service: redis)
REDIS_PORT=6379
SOCIETIX_ONBOARDING_REQUESTS_PER_IP_PER_MINUTE=60
SOCIETIX_MEMBERSHIP_REQUESTS_PER_USER_PER_HOUR=5

# Payment-aggregator sandbox (compose service: pa-sandbox)
PA_MOCK_PORT=1080
