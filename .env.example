# Local development settings, read by docker compose and by the backend.
#
#   cp .env.example .env
#
# .env is git-ignored. These are throwaway local values only: never put real credentials here.
# The defaults already work; change a value only if it clashes with something on your machine
# (for example, another Postgres already using port 5432).

# PostgreSQL 18 + pgvector (compose service: postgres)
DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/societix
# Runtime role the application connects as. It is not a superuser, so tenant RLS applies to it.
SPRING_DATASOURCE_USERNAME=societix_app
SPRING_DATASOURCE_PASSWORD=societix_app
# Owner role: owns the schema and runs the Flyway migrations.
SPRING_FLYWAY_USER=societix
SPRING_FLYWAY_PASSWORD=societix


# Redis 8.2 (compose service: redis)
REDIS_PORT=6379

# Payment-aggregator sandbox (compose service: pa-sandbox)
PA_MOCK_PORT=1080
